# Copia este archivo como .env y completa los valores

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Guayaquil

# Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde esta clave, los datos cifrados no se pueden recuperar.
FIELD_ENCRYPTION_KEY=

DB_NAME=maestro_sombra_app
# Usuario propio de la app (sin privilegios de administrador)
DB_USER=maestro_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

GEMINI_API_KEY=
# Opcional: el modelo principal y los de respaldo (separados por comas) si Google cambia sus nombres
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Enviar a la IA categorías del perfil pedagógico (nunca su texto). Apagado por defecto: además requiere
# una autorización individual vigente del representante que lo cubra.
# AI_PROFILE_TRANSFER_ENABLED=False
# Enviar a la IA los indicadores de una evaluación (nunca las observaciones). Apagado por defecto: además
# requiere una autorización individual vigente que cubra ese tratamiento.
# AI_EVALUATION_TRANSFER_ENABLED=False

# Minutes to adapt one worksheet by hand (reference for the "time saved" metric)
MANUAL_ADAPTATION_MINUTES=60

# Optional: folder with the OCR language models (spa.traineddata)
TESSERACT_DATA_DIR=

# Correo para recuperar la contraseña. Sin estas líneas el correo se imprime en la terminal.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 letras, no es tu contraseña normal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Maestro Sombra <tu-correo@gmail.com>
